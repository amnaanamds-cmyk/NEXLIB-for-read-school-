/* Premium Glassmorphism QSS for GDC Library50 */

QWidget {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
    font-size: 14px;
}

/* Scroll Areas */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollBar:vertical {
    border: none;
    background: rgba(255, 255, 255, 0.05);
    width: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: rgba(160, 180, 204, 0.4);
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

/* Buttons */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1E5FD4, stop:1 #2872F0);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2872F0, stop:1 #3B82F6);
}
QPushButton:pressed {
    background-color: #1D4ED8;
}

QPushButton#ActionBtn {
    background-color: rgba(16, 185, 129, 0.15);
    color: #10B981;
    border: 1px solid rgba(16, 185, 129, 0.4);
}
QPushButton#ActionBtn:hover {
    background-color: rgba(16, 185, 129, 0.3);
}

QPushButton#DangerBtn {
    background-color: rgba(239, 68, 68, 0.15);
    color: #EF4444;
    border: 1px solid rgba(239, 68, 68, 0.4);
}
QPushButton#DangerBtn:hover {
    background-color: rgba(239, 68, 68, 0.3);
}

/* Input Fields */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTextEdit {
    background-color: rgba(13, 31, 56, 0.6);
    border: 1px solid #1E3050;
    border-radius: 8px;
    padding: 10px;
    color: #E8EEF8;
    selection-background-color: #1E5FD4;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTextEdit:focus {
    border: 1px solid #3B82F6;
    background-color: rgba(13, 31, 56, 0.9);
}

/* Tables */
QTableWidget, QTableView {
    background-color: #0D1F38;
    alternate-background-color: #0A182D;
    color: #E8EEF8;
    border: 1px solid #1E3050;
    border-radius: 8px;
    gridline-color: #1E3050;
    selection-background-color: rgba(30, 95, 212, 0.4);
    selection-color: #E8EEF8;
    outline: none;
}
QHeaderView::section {
    background-color: #071428;
    color: #A0B4CC;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #1E3050;
    font-weight: 700;
    font-size: 13px;
}
QTableWidget::item {
    padding: 4px;
    border-bottom: 1px solid rgba(30, 48, 80, 0.5);
}

/* Group Boxes / Cards */
QGroupBox, QFrame#Card {
    background-color: rgba(13, 31, 56, 0.5);
    border: 1px solid #1E3050;
    border-radius: 12px;
    margin-top: 14px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    color: #3B82F6;
    font-weight: bold;
    font-size: 14px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #1E3050;
    border-radius: 8px;
    background: #0D1F38;
}
QTabBar::tab {
    background: #071428;
    color: #6B8CAE;
    padding: 10px 20px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #1E3050;
    color: #E8EEF8;
    border-bottom: 3px solid #3B82F6;
}
QTabBar::tab:hover:!selected {
    background: rgba(30, 48, 80, 0.5);
}

/* Custom Checkbox */
QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 2px solid #1E3050;
    background-color: #0D1F38;
}
QCheckBox::indicator:checked {
    background-color: #10B981;
    border-color: #10B981;
}
