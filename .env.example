# NexLib Desktop — Environment Configuration (all optional)
# Copy this file to .env and adjust if you want to change the defaults.
# The school profile itself (name, address, contact info) is set from
# inside the app on first run — it does not live in this file.

# Auto-logout inactivity timeout in seconds (default 900 = 15 minutes)
INACTIVITY_TIMEOUT=900

# Default fine rate per day, used to prefill the first-run setup wizard
DEFAULT_FINE_RATE=5.0

# App theme: dark or light
DEFAULT_THEME=dark
